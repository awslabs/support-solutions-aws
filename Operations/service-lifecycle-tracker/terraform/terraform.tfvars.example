# =============================================================================
# terraform.tfvars.example - Service Lifecycle Tracker on AWS
# =============================================================================
# deploy-all-terraform.{ps1,sh} writes terraform.tfvars for you. For a manual
# run, copy this file to terraform.tfvars and fill in your values, then stage
# the Lambda code into .backend-stage/ first (see the deploy script, step 1).

# -- Required -----------------------------------------------------------------

# Region to deploy into. Lambda durable functions and Amazon Nova must be
# available there.
region = "us-east-1"

# -- Optional -----------------------------------------------------------------

# Where the deploy script staged backend/*.py + wheels (default: .backend-stage).
# backend_stage_dir = ".backend-stage"

# Service definitions seeded into the config table.
# service_configs_path = "../scripts/service_configs.json"

# CloudWatch log retention in days for the Lambda functions and the HTTP API
# access logs (default: 365, one year).
# log_retention_days = 365

# CloudFront access logs in a dedicated bucket, kept 30 days (default: true).
# Set to false in opt-in Regions, where CloudFront cannot deliver them.
# enable_cloudfront_logging = true

# Solution adoption metrics: a zero-cost CloudFormation marker stack carrying
# the repository tracking code (default: true). Set to false to opt out.
# enable_deployment_metrics = true

# HTTP API throttling across all callers (default 20 requests/s, burst 40).
# api_throttle_rate  = 20
# api_throttle_burst = 40

# Reserved concurrency of the API function (default -1: none). Leave it unset
# on accounts with a low Lambda concurrency quota.
# api_reserved_concurrency = -1

# Hub pipeline role name. IAM is global: override only if the default name is
# already taken in this account (e.g. a CDK deployment in another region).
# pipeline_role_name = "aws-services-lifecycle-pipeline-role"

# Multi-account only: sts:ExternalId presented when assuming spoke roles.
# spoke_external_id = ""
